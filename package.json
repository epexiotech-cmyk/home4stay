{
  "name": "home4stay-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "npm --workspace=apps/main-site run prisma:generate",
    "dev:web": "node scripts/start-dev.js main-site",
    "dev:open": "node scripts/open-browser.js",
    "dev:api": "node scripts/start-dev.js api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:open\"",
    "stop": "node scripts/stop-dev.js",
    "status": "node scripts/status-dev.js",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "generate:test": "node scripts/generate-testing.js"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.4.1",
    "wait-on": "^9.0.5"
  }
}
