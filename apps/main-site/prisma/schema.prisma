enum PaymentProviderType {
  MANUAL_UPI
  RAZORPAY
  CASHFREE
  STRIPE
  PHONEPE
  YES_BANK
}

enum PaymentStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
  ORDER_CREATED
  PAYMENT_PROCESSING
  CALLBACK_PENDING
  VERIFICATION_PENDING
}

enum SubscriptionStatus {
  INACTIVE
