model PaymentTransaction {
  id                   String                 @id @default(uuid())
  propertyId           String                 @map("property_id")
  subscriptionId       String?                @map("subscription_id")
  providerId           String?                @map("provider_id")
  paymentStatus        PaymentStatus          @default(PENDING) @map("payment_status")
  amount               Float
  currency             String                 @default("INR")
  utrNumber            String?                @map("utr_number")
  paymentScreenshotUrl String?                @map("payment_screenshot_url")
  gatewayTransactionId String?                @map("gateway_transaction_id")
  gatewayOrderId       String?                @map("gateway_order_id")
  gatewayResponse      Json?                  @map("gateway_response")
  adminReviewNote      String?                @map("admin_review_note")
  reviewedBy           String?                @map("reviewed_by")
  reviewedAt           DateTime?              @map("reviewed_at")
  paidAt               DateTime?              @map("paid_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  invoices             Invoice[]
  auditLogs            PaymentAuditLog[]
  reconciliation       PaymentReconciliation?
  property             Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider             PaymentProvider?       @relation(fields: [providerId], references: [id])
  subscription         PropertySubscription?  @relation(fields: [subscriptionId], references: [id])
  reconciliationLogs   ReconciliationLog[]

  @@index([propertyId])
  @@index([subscriptionId])
  @@index([providerId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([paymentStatus, createdAt])
  @@map("payment_transactions")
}

