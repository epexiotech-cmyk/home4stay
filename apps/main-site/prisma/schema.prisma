datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("owner") // super_admin, admin, manager, owner, customer
  password  String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // KYC & Trust System
  kycStatus               String    @default("NOT_VERIFIED") @map("kyc_status")
  verifiedBadge           Boolean   @default(false) @map("verified_badge")
  verificationLevel       Int       @default(0) @map("verification_level")
  trustedGuestScore       Int       @default(0) @map("trusted_guest_score")
  verificationCompletedAt DateTime? @map("verification_completed_at")

  reset_password_token   String?   @map("reset_password_token")
  reset_password_expires DateTime? @map("reset_password_expires")

  properties     Property[]
  guestProfile   Guest?     @relation(fields: [guestProfileId], references: [id])
  guestProfileId String?    @unique @map("guest_profile_id")

  conciergeRequests ConciergeRequest[]
  conciergeMessages ConciergeMessage[]

  propertyAccesses PropertyUserAccess[]
  sessions         Session[]
  auditLogs        AuditLog[]
  legalAcceptances LegalAcceptanceLog[]
  invoices         Invoice[]

  referralProfile     ReferralProfile?
  referrerEvents      ReferralEvent[]            @relation("ReferrerEvents")
  referredEvents      ReferralEvent[]            @relation("ReferredEvents")
  referralLedger      ReferralCreditLedger[]
  referralRedemptions ReferralRewardRedemption[]

  // Business Billing Identity
  legalBusinessName String? @map("legal_business_name")
  gstin             String?
  billingAddress    String? @map("billing_address")
  billingState      String? @map("billing_state")
  billingPincode    String? @map("billing_pincode")
  billingContact    String? @map("billing_contact")

  @@index([reset_password_token])
  @@map("users")
}

model Property {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  slug        String    @unique
  title       String
  status      String    @default("DRAFT") // DRAFT, SETUP_IN_PROGRESS, READY_TO_LAUNCH, LIVE, SUSPENDED
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  pageContent       PropertyPageContent?
  mediaAssets       MediaAsset[]
  cmsVersions       CmsVersion[]
  conciergeRequests ConciergeRequest[]
  experiences       PropertyExperience[]
  rooms             Room[]
  reviews           PropertyReview[]
  offers            PropertyOffer[]
  onboardingSession OnboardingSession?

  // Phase B1 Extensions
  propertyType     String?           @map("property_type")
  shortDescription String?           @map("short_description") @db.Text
  onboardingStatus String            @default("NOT_STARTED") @map("onboarding_status")
  amenities        PropertyAmenity[]
  policies         PropertyPolicy?
  pricing          PropertyPricing?

  userAccesses        PropertyUserAccess[]
  aiGenerationEvents  AiGenerationEvent[]
  aiPreferenceSignals AiPreferenceSignal[]
  paymentConfigs      PropertyPaymentConfig[]
  Booking             Booking[]
  subscriptions       PropertySubscription[]
  paymentTransactions PaymentTransaction[]

  @@index([ownerId])
  @@map("properties")
}

model PropertyPageContent {
  id                 String   @id @default(uuid())
  propertyId         String   @unique @map("property_id")
  themeVariant       String   @default("Mountain Luxury") @map("theme_variant")
  spacingPreset      String   @default("relaxed-luxury") @map("spacing_preset")
  animationPreset    String   @default("cinematic-fade-physics") @map("animation_preset")
  publishedVersionId String?  @map("published_version_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sections PropertySection[]

  @@map("property_page_contents")
}

model PropertySection {
  id                    String   @id @default(uuid())
  propertyPageContentId String   @map("property_page_content_id")
  type                  String // hero, narrative, carousel, gallery, testimonials, faq, amenities, seo
  enabled               Boolean  @default(true)
  sortOrder             Int      @default(0) @map("sort_order")
  data                  Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  pageContent PropertyPageContent @relation(fields: [propertyPageContentId], references: [id], onDelete: Cascade)

  @@index([propertyPageContentId])
  @@index([sortOrder])
  @@map("property_sections")
}

model MediaAsset {
  id         String  @id @default(uuid())
  propertyId String  @map("property_id")
  type       String  @default("image") // Backwards compatibility (image/video)
  url        String // Backwards compatibility (public web url)
  blurData   String? @map("blur_data")
  width      Int?    @default(800)
  height     Int?    @default(600)
  tags       String  @default("General") // comma separated tag profiles
  uploadedBy String  @default("partner_owner") @map("uploaded_by")

  // Production-grade media asset fields
  assetType  String   @default("IMAGE") @map("asset_type") // HERO, GALLERY, ROOM, EXPERIENCE, LOGO, COVER
  fileName   String   @default("") @map("file_name")
  storageKey String   @default("") @map("storage_key")
  mimeType   String   @default("image/jpeg") @map("mime_type")
  fileSize   Int      @default(0) @map("file_size")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tags])
  @@map("media_assets")
}

model CmsVersion {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  versionName String   @default("Initial Snapshot") @map("version_name")
  snapshot    Json // full JSON archive of document state at publish time
  published   Boolean  @default(false)
  createdBy   String   @default("concierge_curator_v2") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("cms_versions")
}

model Theme {
  id              String   @id @default(uuid())
  name            String   @unique
  typography      String   @default("Outfit, font-sans")
  spacing         String   @default("relaxed-luxury")
  animationPreset String   @default("cinematic-fade-physics") @map("animation_preset")
  colorPalette    String   @default("slate-teal-amber") @map("color_palette")
  isPremium       Boolean  @default(false) @map("is_premium")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("themes")
}

model Guest {
  id                      String    @id @default(uuid())
  fullName                String    @map("full_name")
  mobile                  String    @unique
  email                   String?   @unique
  gender                  String?
  dob                     DateTime?
  nationality             String    @default("Indian")
  addressLine1            String?   @map("address_line1")
  addressLine2            String?   @map("address_line2")
  city                    String?
  state                   String?
  pincode                 String?
  country                 String    @default("India")
  identityType            String?   @map("identity_type")
  identityNumberMasked    String?   @map("identity_number_masked")
  kycStatus               String    @default("PENDING") @map("kyc_status")
  aadhaarVerified         Boolean   @default(false) @map("aadhaar_verified")
  aadhaarReferenceId      String?   @map("aadhaar_reference_id")
  policeVerificationReady Boolean   @default(false) @map("police_verification_ready")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  kycData     GuestKYC?
  bookings    BookingGuest[]
  userAccount User?

  @@map("guests")
}

model GuestKYC {
  id                    String    @id @default(uuid())
  guestId               String    @unique @map("guest_id")
  documentType          String    @map("document_type")
  documentFront         String?   @map("document_front")
  documentBack          String?   @map("document_back")
  selfieImage           String?   @map("selfie_image")
  verificationProvider  String?   @map("verification_provider")
  verificationStatus    String    @default("PENDING") @map("verification_status")
  otpVerified           Boolean   @default(false) @map("otp_verified")
  verificationTimestamp DateTime? @map("verification_timestamp")
  rawVerificationMeta   String?   @map("raw_verification_meta")
  auditTrail            Json      @default("[]") @map("audit_trail")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("guest_kyc")
}

model Booking {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  roomId        String   @map("room_id")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("DRAFT") // DRAFT, PENDING_KYC, CONFIRMED, CHECKED_IN
  source        String   @default("Direct")
  mealPlan      String   @default("EP") @map("meal_plan")
  paymentStatus String   @default("PENDING") @map("payment_status")
  amount        Float
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  paymentMode                   String?   @map("payment_mode")
  paymentReference              String?   @map("payment_reference")
  utrNumber                     String?   @map("utr_number")
  paymentSubmittedAt            DateTime? @map("payment_submitted_at")
  paymentVerifiedAt             DateTime? @map("payment_verified_at")
  paymentExpiresAt              DateTime? @map("payment_expires_at")
  temporaryInventoryLockedUntil DateTime? @map("temporary_inventory_locked_until")

  guests            BookingGuest[]
  conciergeRequests ConciergeRequest[]
  conciergeServices BookingConciergeService[]
  invoices          InvoiceRecord[]
  notifications     Notification[]

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([roomId])
  @@map("bookings")
}

model BookingConciergeService {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  serviceType String   @map("service_type")
  status      String   @default("REQUESTED") // REQUESTED, CONFIRMED, REJECTED, COMPLETED
  pricingMode String   @default("PREPAID") @map("pricing_mode")
  amount      Float    @default(0)
  configData  Json     @default("{}") @map("config_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_concierge_services")
}

model BookingGuest {
  id             String  @id @default(uuid())
  bookingId      String  @map("booking_id")
  guestId        String  @map("guest_id")
  isPrimaryGuest Boolean @default(false) @map("is_primary_guest")
  occupancyRole  String  @default("Adult") @map("occupancy_role")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([bookingId, guestId])
  @@map("booking_guests")
}

model ConciergeRequest {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  bookingId         String?   @map("booking_id")
  propertyId        String?   @map("property_id")
  category          String // Airport Pickup, Housekeeping, Local Tour, etc.
  priority          String    @default("NORMAL") // NORMAL, URGENT, VIP_PRIORITY
  title             String
  description       String
  status            String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  assignedTo        String?   @map("assigned_to")
  preferredDateTime DateTime? @map("preferred_date_time")
  metadata          Json      @default("{}") // For category specific details
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking  Booking?           @relation(fields: [bookingId], references: [id])
  property Property?          @relation(fields: [propertyId], references: [id])
  messages ConciergeMessage[]

  @@index([userId])
  @@index([status])
  @@map("concierge_requests")
}

model ConciergeMessage {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  senderId   String   @map("sender_id")
  senderType String   @map("sender_type")
  message    String
  attachment String? // URL to image/document
  createdAt  DateTime @default(now()) @map("created_at")

  request ConciergeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User             @relation(fields: [senderId], references: [id])

  @@index([requestId])
  @@map("concierge_messages")
}

model PropertyExperience {
  id                 String   @id @default(uuid())
  propertyId         String   @map("property_id")
  title              String
  slug               String
  description        String
  category           String
  price              Float    @default(0)
  isComplimentary    Boolean  @default(false) @map("is_complimentary")
  isFeatured         Boolean  @default(false) @map("is_featured")
  icon               String?
  coverImage         String?  @map("cover_image")
  duration           String?
  maxGuests          Int?     @map("max_guests")
  requiresScheduling Boolean  @default(false) @map("requires_scheduling")
  availabilityType   String   @default("always") @map("availability_type") // always, seasonal, weekend, custom
  customAvailability Json?    @map("custom_availability") // For custom date ranges/days
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
  @@map("property_experiences")
}

model Room {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  name       String
  price      Float
  capacity   String
  view       String
  images     Json     @default("[]")
  roomType   String?  @map("room_type")
  roomCount  Int      @default(1) @map("room_count")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Booking  Booking[]

  @@index([propertyId])
  @@map("rooms")
}

model PropertyAmenity {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  category    String
  name        String
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_amenities")
}

model PropertyPolicy {
  id                 String   @id @default(uuid())
  propertyId         String   @unique @map("property_id")
  checkInTime        String   @map("check_in_time")
  checkOutTime       String   @map("check_out_time")
  petsAllowed        Boolean  @default(false) @map("pets_allowed")
  smokingAllowed     Boolean  @default(false) @map("smoking_allowed")
  cancellationPolicy String   @map("cancellation_policy") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_policies")
}

model PropertyPricing {
  id         String   @id @default(uuid())
  propertyId String   @unique @map("property_id")
  basePrice  Float    @map("base_price")
  currency   String   @default("INR")
  taxRate    Float    @default(0.0) @map("tax_rate")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_pricing")
}

model PropertyReview {
  id              String    @id @default(uuid())
  propertyId      String    @map("property_id")
  guestName       String    @map("guest_name")
  guestAvatar     String?   @map("guest_avatar")
  rating          Int
  title           String
  message         String
  stayType        String    @map("stay_type")
  roomType        String    @map("room_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  isVerified      Boolean   @default(false) @map("is_verified")
  isPublished     Boolean   @default(false) @map("is_published")
  isFeatured      Boolean   @default(false) @map("is_featured")
  responseMessage String?   @map("response_message")
  responseAt      DateTime? @map("response_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_reviews")
}

model PropertyOffer {
  id                    String   @id @default(uuid())
  propertyId            String   @map("property_id")
  title                 String
  slug                  String
  description           String
  bannerImage           String?  @map("banner_image")
  offerType             String   @map("offer_type") // discount, package, seasonal, early_bird
  discountType          String   @map("discount_type") // percentage, flat
  discountValue         Float    @map("discount_value")
  couponCode            String   @map("coupon_code")
  minimumBookingAmount  Float    @map("minimum_booking_amount")
  startDate             DateTime @map("start_date")
  endDate               DateTime @map("end_date")
  isActive              Boolean  @default(true) @map("is_active")
  isFeatured            Boolean  @default(false) @map("is_featured")
  applicableRooms       Json     @default("[]") @map("applicable_rooms")
  applicableExperiences Json     @default("[]") @map("applicable_experiences")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([couponCode])
  @@map("property_offers")
}

model RoomInventory {
  roomId         String @id @map("room_id")
  availableCount Int    @map("available_count")

  @@map("room_inventory")
}

// =========================================================================
// PRODUCTION-GRADE AUTHENTICATION & RBAC SCHEMA ADDITIONS
// =========================================================================

model PropertyUserAccess {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  userId     String   @map("user_id")
  role       String   @default("manager") // owner, manager, receptionist, billing, housekeeping
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_user_access")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  sessionToken     String   @unique @map("session_token")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String // e.g., USER_LOGIN, USER_LOGOUT, ROLE_CHANGE
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  status       String // SUCCESS, FAILURE
  metadata     Json?    @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OnboardingSession {
  id          String   @id @default(uuid())
  propertyId  String   @unique @map("property_id")
  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, LIVE
  currentStep String   @default("welcome") @map("current_step")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  progress PropertySetupProgress[]
  drafts   WizardDraft[]

  @@map("onboarding_sessions")
}

model PropertySetupProgress {
  id                  String    @id @default(uuid())
  onboardingSessionId String    @map("onboarding_session_id")
  stepId              String    @map("step_id") // welcome, property, theme, rooms, amenities, experiences, gallery, policies, pricing, launch
  status              String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  session OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  @@unique([onboardingSessionId, stepId])
  @@map("property_setup_progress")
}

model WizardDraft {
  id                  String   @id @default(uuid())
  onboardingSessionId String   @map("onboarding_session_id")
  stepId              String   @map("step_id") // welcome, property, theme, rooms, etc.
  data                Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  session OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  @@unique([onboardingSessionId, stepId])
  @@map("wizard_drafts")
}

model AiGenerationEvent {
  id                 String   @id @default(uuid())
  propertyId         String   @map("property_id")
  generationType     String   @map("generation_type") // PROPERTY_DESCRIPTION, TAGLINE, SEO_METADATA, AMENITIES, EXPERIENCES, THEME_RECOMMENDATION
  inputContext       Json     @default("{}") @map("input_context")
  generatedOutput    Json     @default("{}") @map("generated_output")
  selectedTheme      String?  @map("selected_theme")
  stepContext        String?  @map("step_context")
  accepted           Boolean  @default(false)
  edited             Boolean  @default(false)
  regenerated        Boolean  @default(false)
  finalSavedOutput   Json?    @map("final_saved_output")
  editDistance       Float    @default(0.0) @map("edit_distance")
  generationDuration Int      @default(0) @map("generation_duration")
  createdAt          DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([generationType])
  @@map("ai_generation_events")
}

model AiPreferenceSignal {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  category   String // theme, vibe, amenities, tone, experiences
  signalKey  String   @map("signal_key")
  score      Float    @default(1.0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, category, signalKey])
  @@map("ai_preference_signals")
}

model PropertyPaymentConfig {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  provider      String // e.g., "SMART_UPI", "RAZORPAY", etc.
  upiId         String?  @map("upi_id")
  merchantName  String?  @map("merchant_name")
  bankName      String?  @map("bank_name")
  gatewayKey    String?  @map("gateway_key")
  gatewaySecret String?  @map("gateway_secret") // encrypted
  webhookSecret String?  @map("webhook_secret") // encrypted
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_payment_configs")
}

model InvoiceRecord {
  id               String   @id @default(uuid())
  bookingId        String   @map("booking_id")
  invoiceNumber    String   @unique @map("invoice_number")
  status           String   @default("DRAFT") // DRAFT, PAID, CANCELLED
  generatedAt      DateTime @default(now()) @map("generated_at")
  paymentReference String?  @map("payment_reference")
  utrNumber        String?  @map("utr_number")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("invoice_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // Recipient User ID
  bookingId String?  @map("booking_id")
  title     String
  message   String
  type      String // e.g. PAYMENT_SUBMITTED, BOOKING_CONFIRMED, BOOKING_EXPIRED
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model EmailJob {
  id          String    @id @default(uuid())
  recipient   String
  subject     String
  htmlBody    String    @map("html_body")
  attempts    Int       @default(0)
  maxRetries  Int       @default(3) @map("max_retries")
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status])
  @@map("email_jobs")
}

// ==========================================
// PHASE 1 — PAYMENT FOUNDATION ARCHITECTURE
// ==========================================

enum PaymentProviderType {
  MANUAL_UPI
  RAZORPAY
  CASHFREE
  STRIPE
  PHONEPE
  YES_BANK
}

enum PaymentStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
  ORDER_CREATED
  PAYMENT_PROCESSING
  CALLBACK_PENDING
  VERIFICATION_PENDING
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
  RENEWAL_DUE
  IN_GRACE_PERIOD
  SUSPENDED_OVERDUE
  RENEWED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

model PaymentProvider {
  id            String              @id @default(uuid())
  providerType  PaymentProviderType @map("provider_type")
  displayName   String              @map("display_name")
  isEnabled     Boolean             @default(true) @map("is_enabled")
  isManual      Boolean             @default(false) @map("is_manual")
  isSandbox     Boolean             @default(false) @map("is_sandbox")
  isDefault     Boolean             @default(false) @map("is_default")
  priority      Int                 @default(0) @map("priority")
  apiKey        String?             @map("api_key")
  secretKey     String?             @map("secret_key")
  webhookSecret String?             @map("webhook_secret")
  merchantId    String?             @map("merchant_id")
  merchantName  String?             @map("merchant_name")
  upiId         String?             @map("upi_id")
  qrImageUrl    String?             @map("qr_image_url")
  instructions  String?             @map("instructions")
  supportNumber String?             @map("support_number")
  supportEmail  String?             @map("support_email")
  gatewayConfig Json?               @map("gateway_config")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  transactions PaymentTransaction[]

  @@map("payment_providers")
}

model PropertySubscription {
  id             String             @id @default(uuid())
  propertyId     String             @map("property_id")
  selectedPlanId String             @map("selected_plan_id")
  status         SubscriptionStatus @default(INACTIVE)
  billingCycle   BillingCycle       @map("billing_cycle")
  amount         Float
  currency       String             @default("INR")
  startsAt       DateTime?          @map("starts_at")
  expiresAt      DateTime?          @map("expires_at")
  activatedAt    DateTime?          @map("activated_at")
  suspendedAt    DateTime?          @map("suspended_at")
  createdBy      String?            @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  property            Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions        PaymentTransaction[]
  invoices            Invoice[]
  referralRedemptions ReferralRewardRedemption[]

  @@index([propertyId])
  @@index([status])
  @@map("property_subscriptions")
}

model SubscriptionPlan {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  description      String
  shortDescription String? @map("short_description")
  isActive         Boolean @default(true) @map("is_active")
  isFeatured       Boolean @default(false) @map("is_featured")
  displayOrder     Int     @default(0) @map("display_order")

  // Pricing Options
  monthlyPrice   Float @map("monthly_price")
  quarterlyPrice Float @map("quarterly_price")
  yearlyPrice    Float @map("yearly_price")
  lifetimePrice  Float @map("lifetime_price")

  // Limits
  maxProperties        Int @default(1) @map("max_properties")
  maxImagesPerProperty Int @default(10) @map("max_images_per_property")
  maxVideosPerProperty Int @default(1) @map("max_videos_per_property")
  maxRoomListings      Int @default(5) @map("max_room_listings")
  maxBookingsPerMonth  Int @default(100) @map("max_bookings_per_month")

  // Flags & badges
  featureFlags    Json    @default("{}") @map("feature_flags")
  customBadge     String? @map("custom_badge")
  supportPriority String  @default("NORMAL") @map("support_priority")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([slug])
  @@index([isActive])
  @@map("subscription_plans")
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  propertyId           String        @map("property_id")
  subscriptionId       String?       @map("subscription_id")
  providerId           String?       @map("provider_id")
  paymentStatus        PaymentStatus @default(PENDING) @map("payment_status")
  amount               Float
  currency             String        @default("INR")
  utrNumber            String?       @map("utr_number")
  paymentScreenshotUrl String?       @map("payment_screenshot_url")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  gatewayOrderId       String?       @map("gateway_order_id")
  gatewayResponse      Json?         @map("gateway_response")
  adminReviewNote      String?       @map("admin_review_note")
  reviewedBy           String?       @map("reviewed_by")
  reviewedAt           DateTime?     @map("reviewed_at")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subscription       PropertySubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider           PaymentProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  auditLogs          PaymentAuditLog[]
  reconciliation     PaymentReconciliation?
  invoices           Invoice[]
  reconciliationLogs ReconciliationLog[]

  @@index([propertyId])
  @@index([subscriptionId])
  @@index([providerId])
  @@index([paymentStatus])
  @@map("payment_transactions")
}

model PaymentAuditLog {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  action        String
  oldStatus     String?  @map("old_status")
  newStatus     String?  @map("new_status")
  performedBy   String?  @map("performed_by")
  metadata      Json?    @map("metadata")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payment_audit_logs")
}

model AutomationJobLog {
  id               String   @id @default(uuid())
  jobType          String   @map("job_type") // EXPIRY_SCAN, GRACE_SCAN, REMINDER_SCAN, SUSPENSION_PROCESSING
  status           String // SUCCESS, FAILED
  recordsProcessed Int      @default(0) @map("records_processed")
  errorMessage     String?  @map("error_message")
  logs             Json? // Detailed execution trace messages
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("automation_job_logs")
}

model PaymentReconciliation {
  id                   String   @id @default(uuid())
  transactionId        String   @unique @map("transaction_id")
  gatewayTransactionId String?  @map("gateway_transaction_id")
  bankReference        String?  @map("bank_reference")
  settlementReference  String?  @map("settlement_reference")
  reconciliationStatus String   @default("UNRECONCILED") // UNRECONCILED, MATCHED, MISMATCHED, SYSTEM_ADJUSTED
  verificationState    String   @default("PENDING") // PENDING, VERIFIED, FAILED
  mismatchReason       String?  @map("mismatch_reason")
  callbackLogs         Json?    @map("callback_logs") // JSON array of logs
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_reconciliations")
}

// ==========================================
// PHASE 10A — LEGAL AGREEMENTS & COMPLIANCE
// ==========================================

enum LegalDocumentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  REFUND_POLICY
  SUBSCRIPTION_AGREEMENT
}

model LegalDocument {
  id           String            @id @default(uuid())
  documentType LegalDocumentType @map("document_type")
  title        String
  slug         String
  version      String
  content      String            @db.Text
  isActive     Boolean           @default(false) @map("is_active")
  publishedAt  DateTime?         @map("published_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  acceptances LegalAcceptanceLog[]

  @@unique([documentType, version])
  @@index([slug])
  @@index([documentType, isActive])
  @@map("legal_documents")
}

model LegalAcceptanceLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  documentId      String   @map("document_id")
  acceptedVersion String   @map("accepted_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  metadata        Json?    @default("{}") @map("metadata")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("legal_acceptance_logs")
}

// ==========================================
// PHASE 10B — GST INVOICE ENGINE & FINANCIAL
// ==========================================

enum InvoiceType {
  SUBSCRIPTION
  RENEWAL
  MANUAL_ADJUSTMENT
  REFUND
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

model FinancialSettings {
  id                    String   @id @default(uuid())
  companyName           String   @map("company_name")
  legalBusinessName     String   @map("legal_business_name")
  GSTIN                 String
  PAN                   String
  address               String
  supportEmail          String   @map("support_email")
  supportPhone          String   @map("support_phone")
  invoicePrefix         String   @map("invoice_prefix")
  invoiceStartingNumber Int      @default(1) @map("invoice_starting_number")
  defaultGSTPercent     Float    @default(18.0) @map("default_gst_percent")
  SACCode               String   @map("sac_code")
  bankDetails           Json     @map("bank_details")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Tax split, place of supply, SLA, and liability configurations (Phase 10A.5)
  defaultStateCode     String? @default("24") @map("default_state_code")
  placeOfSupplyMode    String? @default("STATE_MATCH") @map("place_of_supply_mode")
  enableGSTSplitting   Boolean @default(true) @map("enable_gst_splitting")
  enableIGST           Boolean @default(true) @map("enable_igst")
  invoiceTerms         String? @map("invoice_terms") @db.Text
  refundTerms          String? @map("refund_terms") @db.Text
  SLAUptimeTarget      Float?  @default(99.9) @map("sla_uptime_target")
  SLAMaintenanceWindow String? @default("Sunday 02:00 AM - 04:00 AM IST") @map("sla_maintenance_window")
  liabilityCapMonths   Int?    @default(6) @map("liability_cap_months")
  dataRetentionDays    Int?    @default(365) @map("data_retention_days")

  @@map("financial_settings")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  userId         String        @map("user_id")
  subscriptionId String?       @map("subscription_id")
  transactionId  String?       @map("transaction_id")
  invoiceType    InvoiceType   @map("invoice_type")
  status         InvoiceStatus @default(DRAFT)
  subtotal       Float
  gstPercent     Float         @map("gst_percent")
  gstAmount      Float         @map("gst_amount")
  totalAmount    Float         @map("total_amount")
  currency       String        @default("INR")
  billingName    String        @map("billing_name")
  billingAddress String        @map("billing_address")
  GSTIN          String?
  invoicePdfUrl  String?       @map("invoice_pdf_url")
  metadata       Json          @default("{}")
  issuedAt       DateTime?     @map("issued_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // E-invoice compliance fields (Phase 10A.5)
  irn           String?
  eInvoiceQrUrl String? @map("e_invoice_qr_url")
  govAckId      String? @map("gov_ack_id")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       PropertySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  transaction        PaymentTransaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reconciliationLogs ReconciliationLog[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([transactionId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ==========================================
// PHASE 10C — ACCOUNTING & RECONCILIATION
// ==========================================

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  PENDING
  FAILED
}

model SettlementRecord {
  id                  String               @id @default(uuid())
  providerType        String               @map("provider_type")
  settlementReference String               @unique @map("settlement_reference")
  settlementDate      DateTime             @map("settlement_date")
  settlementAmount    Float                @map("settlement_amount")
  currency            String               @default("INR")
  status              ReconciliationStatus @default(PENDING)
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  reconciliationLogs ReconciliationLog[]

  @@map("settlement_records")
}

model ReconciliationLog {
  id                   String               @id @default(uuid())
  transactionId        String?              @map("transaction_id")
  invoiceId            String?              @map("invoice_id")
  settlementRecordId   String?              @map("settlement_record_id")
  reconciliationStatus ReconciliationStatus @map("reconciliation_status")
  expectedAmount       Float                @map("expected_amount")
  receivedAmount       Float                @map("received_amount")
  mismatchAmount       Float                @map("mismatch_amount")
  notes                String?
  reconciledAt         DateTime?            @map("reconciled_at")
  metadata             Json                 @default("{}")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  transaction      PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  settlementRecord SettlementRecord?   @relation(fields: [settlementRecordId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([invoiceId])
  @@index([settlementRecordId])
  @@map("reconciliation_logs")
}

// ==========================================
// PHASE 11 — REFERRALS & REWARDS
// ==========================================

enum ReferralEventStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
  FRAUD_FLAGGED
}

model ReferralProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  referralCode    String   @unique @map("referral_code")
  totalCredits    Int      @default(0) @map("total_credits")
  lifetimeCredits Int      @default(0) @map("lifetime_credits")
  pendingCredits  Int      @default(0) @map("pending_credits")
  redeemedCredits Int      @default(0) @map("redeemed_credits")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_profiles")
}

model ReferralEvent {
  id                       String              @id @default(uuid())
  referrerUserId           String              @map("referrer_user_id")
  referredUserId           String              @map("referred_user_id")
  referredPropertyId       String?             @map("referred_property_id")
  qualifyingSubscriptionId String?             @map("qualifying_subscription_id")
  status                   ReferralEventStatus @default(PENDING)
  creditsAwarded           Int                 @default(0) @map("credits_awarded")
  awardedAt                DateTime?           @map("awarded_at")
  metadata                 Json                @default("{}")
  createdAt                DateTime            @default(now()) @map("created_at")

  referrer User @relation("ReferrerEvents", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredEvents", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referral_events")
}

model ReferralCreditLedger {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  eventType    String   @map("event_type")
  credits      Int
  balanceAfter Int      @map("balance_after")
  referenceId  String?  @map("reference_id")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_credit_ledger")
}

model ReferralRewardRedemption {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  subscriptionId   String   @map("subscription_id")
  creditsUsed      Int      @map("credits_used")
  rewardType       String   @map("reward_type")
  discountAmount   Float    @map("discount_amount")
  billingCycle     String   @map("billing_cycle")
  remainingCredits Int      @map("remaining_credits")
  createdAt        DateTime @default(now()) @map("created_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription PropertySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("referral_reward_redemptions")
}
