generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                     @id @default(uuid())
  email                   String                     @unique
  name                    String?
  role                    String                     @default("owner")
  password                String
  phone                   String?
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  kycStatus               String                     @default("NOT_VERIFIED") @map("kyc_status")
  verifiedBadge           Boolean                    @default(false) @map("verified_badge")
  verificationLevel       Int                        @default(0) @map("verification_level")
  trustedGuestScore       Int                        @default(0) @map("trusted_guest_score")
  verificationCompletedAt DateTime?                  @map("verification_completed_at")
  reset_password_token    String?                    @map("reset_password_token")
  reset_password_expires  DateTime?                  @map("reset_password_expires")
  guestProfileId          String?                    @unique @map("guest_profile_id")
  legalBusinessName       String?                    @map("legal_business_name")
  gstin                   String?
  billingAddress          String?                    @map("billing_address")
  billingState            String?                    @map("billing_state")
  billingPincode          String?                    @map("billing_pincode")
  billingContact          String?                    @map("billing_contact")
  status                  String                     @default("ACTIVE")
  auditLogs               AuditLog[]
  conciergeMessages       ConciergeMessage[]
  conciergeRequests       ConciergeRequest[]
  invoices                Invoice[]
  legalAcceptances        LegalAcceptanceLog[]
  properties              Property[]
  propertyAccesses        PropertyUserAccess[]
  referralLedger          ReferralCreditLedger[]
  referredEvents          ReferralEvent[]            @relation("ReferredEvents")
  referrerEvents          ReferralEvent[]            @relation("ReferrerEvents")
  referralProfile         ReferralProfile?
  referralRedemptions     ReferralRewardRedemption[]
  sessions                Session[]
  hostProfile             UserHostProfile?
  guestProfile            Guest?                     @relation(fields: [guestProfileId], references: [id])

  @@index([reset_password_token])
  @@map("users")
}

model Property {
  id                       String                    @id @default(uuid())
  ownerId                  String                    @map("owner_id")
  slug                     String                    @unique
  title                    String
  status                   String                    @default("DRAFT")
  publishedAt              DateTime?                 @map("published_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  propertyType             String?                   @map("property_type")
  shortDescription         String?                   @map("short_description")
  onboardingStatus         String                    @default("NOT_STARTED") @map("onboarding_status")
  subdomain                String?                   @unique @map("subdomain")
  aggregateRating          Float?                    @map("aggregate_rating")
  contactPhone             String?                   @map("contact_phone")
  contactWhatsapp          String?                   @map("contact_whatsapp")
  location                 String?
  aiGenerationEvents       AiGenerationEvent[]
  aiPreferenceSignals      AiPreferenceSignal[]
  Booking                  Booking[]
  cmsVersions              CmsVersion[]
  conciergeRequests        ConciergeRequest[]
  conciergeServiceCatalogs ConciergeServiceCatalog[]
  mediaAssets              MediaAsset[]
  onboardingSession        OnboardingSession?
  paymentTransactions      PaymentTransaction[]
  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyActivation       PropertyActivation?
  agreements               PropertyAgreement[]
  amenities                PropertyAmenity[]
  experiences              PropertyExperience[]
  mealPlans                PropertyMealPlan[]
  offers                   PropertyOffer[]
  pageContent              PropertyPageContent?
  paymentConfigs           PropertyPaymentConfig[]
  policies                 PropertyPolicy?
  pricing                  PropertyPricing?
  reviews                  PropertyReview[]
  subscriptions            PropertySubscription[]
  userAccesses             PropertyUserAccess[]
  rooms                    Room[]

  @@index([ownerId])
  @@index([status])
  @@index([status, publishedAt])
  @@map("properties")
}

model PropertyPageContent {
  id                 String            @id @default(uuid())
  propertyId         String            @unique @map("property_id")
  themeVariant       String            @default("Mountain Luxury") @map("theme_variant")
  spacingPreset      String            @default("relaxed-luxury") @map("spacing_preset")
  animationPreset    String            @default("cinematic-fade-physics") @map("animation_preset")
  publishedVersionId String?           @map("published_version_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sections           PropertySection[]

  @@map("property_page_contents")
}

model PropertySection {
  id                    String              @id @default(uuid())
  propertyPageContentId String              @map("property_page_content_id")
  type                  String
  enabled               Boolean             @default(true)
  sortOrder             Int                 @default(0) @map("sort_order")
  data                  Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  pageContent           PropertyPageContent @relation(fields: [propertyPageContentId], references: [id], onDelete: Cascade)

  @@index([propertyPageContentId])
  @@index([sortOrder])
  @@map("property_sections")
}

model MediaAsset {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  type       String   @default("image")
  url        String
  blurData   String?  @map("blur_data")
  width      Int?     @default(800)
  height     Int?     @default(600)
  tags       String   @default("General")
  uploadedBy String   @default("partner_owner") @map("uploaded_by")
  assetType  String   @default("IMAGE") @map("asset_type")
  fileName   String   @default("") @map("file_name")
  storageKey String   @default("") @map("storage_key")
  mimeType   String   @default("image/jpeg") @map("mime_type")
  fileSize   Int      @default(0) @map("file_size")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tags])
  @@map("media_assets")
}

model CmsVersion {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  versionName String   @default("Initial Snapshot") @map("version_name")
  snapshot    Json
  published   Boolean  @default(false)
  createdBy   String   @default("concierge_curator_v2") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("cms_versions")
}

model Theme {
  id              String   @id @default(uuid())
  name            String   @unique
  typography      String   @default("Outfit, font-sans")
  spacing         String   @default("relaxed-luxury")
  animationPreset String   @default("cinematic-fade-physics") @map("animation_preset")
  colorPalette    String   @default("slate-teal-amber") @map("color_palette")
  isPremium       Boolean  @default(false) @map("is_premium")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("themes")
}

model Guest {
  id                      String         @id @default(uuid())
  fullName                String         @map("full_name")
  mobile                  String         @unique
  email                   String?        @unique
  gender                  String?
  dob                     DateTime?
  nationality             String         @default("Indian")
  addressLine1            String?        @map("address_line1")
  addressLine2            String?        @map("address_line2")
  city                    String?
  state                   String?
  pincode                 String?
  country                 String         @default("India")
  identityType            String?        @map("identity_type")
  identityNumberMasked    String?        @map("identity_number_masked")
  kycStatus               String         @default("PENDING") @map("kyc_status")
  aadhaarVerified         Boolean        @default(false) @map("aadhaar_verified")
  aadhaarReferenceId      String?        @map("aadhaar_reference_id")
  policeVerificationReady Boolean        @default(false) @map("police_verification_ready")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  bookings                BookingGuest[]
  kycData                 GuestKYC?
  userAccount             User?

  @@map("guests")
}

model GuestKYC {
  id                    String    @id @default(uuid())
  guestId               String    @unique @map("guest_id")
  documentType          String    @map("document_type")
  documentFront         String?   @map("document_front")
  documentBack          String?   @map("document_back")
  selfieImage           String?   @map("selfie_image")
  verificationProvider  String?   @map("verification_provider")
  verificationStatus    String    @default("PENDING") @map("verification_status")
  otpVerified           Boolean   @default(false) @map("otp_verified")
  verificationTimestamp DateTime? @map("verification_timestamp")
  rawVerificationMeta   String?   @map("raw_verification_meta")
  auditTrail            Json      @default("[]") @map("audit_trail")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  guest                 Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("guest_kyc")
}

model Booking {
  id                            String                    @id @default(uuid())
  propertyId                    String                    @map("property_id")
  roomId                        String                    @map("room_id")
  startDate                     DateTime                  @map("start_date")
  endDate                       DateTime                  @map("end_date")
  status                        String                    @default("DRAFT")
  source                        String                    @default("Direct")
  mealPlan                      String                    @default("EP") @map("meal_plan")
  paymentStatus                 String                    @default("PENDING") @map("payment_status")
  amount                        Float
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  paymentMode                   String?                   @map("payment_mode")
  paymentReference              String?                   @map("payment_reference")
  utrNumber                     String?                   @map("utr_number")
  paymentSubmittedAt            DateTime?                 @map("payment_submitted_at")
  paymentVerifiedAt             DateTime?                 @map("payment_verified_at")
  paymentExpiresAt              DateTime?                 @map("payment_expires_at")
  temporaryInventoryLockedUntil DateTime?                 @map("temporary_inventory_locked_until")
  conciergeServices             BookingConciergeService[]
  guests                        BookingGuest[]
  property                      Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room                          Room                      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  conciergeRequests             ConciergeRequest[]
  invoices                      InvoiceRecord[]
  notifications                 Notification[]

  @@index([propertyId])
  @@index([roomId])
  @@index([createdAt])
  @@index([propertyId, createdAt])
  @@index([propertyId, startDate, endDate])
  @@map("bookings")
}

model BookingConciergeService {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  serviceType String   @map("service_type")
  status      String   @default("REQUESTED")
  pricingMode String   @default("PREPAID") @map("pricing_mode")
  amount      Float    @default(0)
  configData  Json     @default("{}") @map("config_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_concierge_services")
}

model BookingGuest {
  id             String  @id @default(uuid())
  bookingId      String  @map("booking_id")
  guestId        String  @map("guest_id")
  isPrimaryGuest Boolean @default(false) @map("is_primary_guest")
  occupancyRole  String  @default("Adult") @map("occupancy_role")
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest          Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([bookingId, guestId])
  @@map("booking_guests")
}

model ConciergeRequest {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  bookingId         String?            @map("booking_id")
  propertyId        String?            @map("property_id")
  category          String
  priority          String             @default("NORMAL")
  title             String
  description       String
  status            String             @default("SUBMITTED")
  assignedTo        String?            @map("assigned_to")
  preferredDateTime DateTime?          @map("preferred_date_time")
  metadata          Json               @default("{}")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  messages          ConciergeMessage[]
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  property          Property?          @relation(fields: [propertyId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("concierge_requests")
}

model ConciergeMessage {
  id         String           @id @default(uuid())
  requestId  String           @map("request_id")
  senderId   String           @map("sender_id")
  senderType String           @map("sender_type")
  message    String
  attachment String?
  createdAt  DateTime         @default(now()) @map("created_at")
  request    ConciergeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender     User             @relation(fields: [senderId], references: [id])

  @@index([requestId])
  @@map("concierge_messages")
}

model PropertyExperience {
  id                 String   @id @default(uuid())
  propertyId         String   @map("property_id")
  title              String
  slug               String
  description        String
  category           String
  price              Float    @default(0)
  isComplimentary    Boolean  @default(false) @map("is_complimentary")
  isFeatured         Boolean  @default(false) @map("is_featured")
  icon               String?
  coverImage         String?  @map("cover_image")
  duration           String?
  maxGuests          Int?     @map("max_guests")
  requiresScheduling Boolean  @default(false) @map("requires_scheduling")
  availabilityType   String   @default("always") @map("availability_type")
  customAvailability Json?    @map("custom_availability")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
  @@map("property_experiences")
}

model Room {
  id         String    @id @default(uuid())
  propertyId String    @map("property_id")
  name       String
  price      Float
  capacity   String
  view       String
  images     Json      @default("[]")
  roomType   String?   @map("room_type")
  roomCount  Int       @default(1) @map("room_count")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  bedType    String?   @map("bed_type")
  sizeSqFt   Int?      @map("size_sq_ft")
  tags       Json      @default("[]")
  Booking    Booking[]
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("rooms")
}

model PropertyAmenity {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  category    String
  name        String
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_amenities")
}

model PropertyPolicy {
  id                 String   @id @default(uuid())
  propertyId         String   @unique @map("property_id")
  checkInTime        String   @map("check_in_time")
  checkOutTime       String   @map("check_out_time")
  petsAllowed        Boolean  @default(false) @map("pets_allowed")
  smokingAllowed     Boolean  @default(false) @map("smoking_allowed")
  cancellationPolicy String   @map("cancellation_policy")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  houseRules         String?  @map("house_rules")
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_policies")
}

model PropertyPricing {
  id         String   @id @default(uuid())
  propertyId String   @unique @map("property_id")
  basePrice  Float    @map("base_price")
  currency   String   @default("INR")
  taxRate    Float    @default(0.0) @map("tax_rate")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_pricing")
}

model PropertyReview {
  id              String    @id @default(uuid())
  propertyId      String    @map("property_id")
  guestName       String    @map("guest_name")
  guestAvatar     String?   @map("guest_avatar")
  rating          Int
  title           String
  message         String
  stayType        String    @map("stay_type")
  roomType        String    @map("room_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  isVerified      Boolean   @default(false) @map("is_verified")
  isPublished     Boolean   @default(false) @map("is_published")
  isFeatured      Boolean   @default(false) @map("is_featured")
  responseMessage String?   @map("response_message")
  responseAt      DateTime? @map("response_at")
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_reviews")
}

model PropertyOffer {
  id                    String   @id @default(uuid())
  propertyId            String   @map("property_id")
  title                 String
  slug                  String
  description           String
  bannerImage           String?  @map("banner_image")
  offerType             String   @map("offer_type")
  discountType          String   @map("discount_type")
  discountValue         Float    @map("discount_value")
  couponCode            String   @map("coupon_code")
  minimumBookingAmount  Float    @map("minimum_booking_amount")
  startDate             DateTime @map("start_date")
  endDate               DateTime @map("end_date")
  isActive              Boolean  @default(true) @map("is_active")
  isFeatured            Boolean  @default(false) @map("is_featured")
  applicableRooms       Json     @default("[]") @map("applicable_rooms")
  applicableExperiences Json     @default("[]") @map("applicable_experiences")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([couponCode])
  @@map("property_offers")
}

model RoomInventory {
  roomId         String @id @map("room_id")
  availableCount Int    @map("available_count")

  @@map("room_inventory")
}

model PropertyUserAccess {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  userId     String   @map("user_id")
  role       String   @default("manager")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_user_access")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  sessionToken     String   @unique @map("session_token")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  status       String
  metadata     Json?    @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OnboardingSession {
  id          String                  @id @default(uuid())
  propertyId  String                  @unique @map("property_id")
  status      String                  @default("NOT_STARTED")
  currentStep String                  @default("welcome") @map("current_step")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  property    Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  progress    PropertySetupProgress[]
  drafts      WizardDraft[]

  @@map("onboarding_sessions")
}

model PropertySetupProgress {
  id                  String            @id @default(uuid())
  onboardingSessionId String            @map("onboarding_session_id")
  stepId              String            @map("step_id")
  status              String            @default("PENDING")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  session             OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  @@unique([onboardingSessionId, stepId])
  @@map("property_setup_progress")
}

model WizardDraft {
  id                  String            @id @default(uuid())
  onboardingSessionId String            @map("onboarding_session_id")
  stepId              String            @map("step_id")
  data                Json              @default("{}")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  session             OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  @@unique([onboardingSessionId, stepId])
  @@map("wizard_drafts")
}

model AiGenerationEvent {
  id                 String   @id @default(uuid())
  propertyId         String   @map("property_id")
  generationType     String   @map("generation_type")
  inputContext       Json     @default("{}") @map("input_context")
  generatedOutput    Json     @default("{}") @map("generated_output")
  selectedTheme      String?  @map("selected_theme")
  stepContext        String?  @map("step_context")
  accepted           Boolean  @default(false)
  edited             Boolean  @default(false)
  regenerated        Boolean  @default(false)
  finalSavedOutput   Json?    @map("final_saved_output")
  editDistance       Float    @default(0.0) @map("edit_distance")
  generationDuration Int      @default(0) @map("generation_duration")
  createdAt          DateTime @default(now()) @map("created_at")
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([generationType])
  @@map("ai_generation_events")
}

model AiPreferenceSignal {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  category   String
  signalKey  String   @map("signal_key")
  score      Float    @default(1.0)
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, category, signalKey])
  @@map("ai_preference_signals")
}

model PropertyPaymentConfig {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  provider      String
  upiId         String?  @map("upi_id")
  merchantName  String?  @map("merchant_name")
  bankName      String?  @map("bank_name")
  gatewayKey    String?  @map("gateway_key")
  gatewaySecret String?  @map("gateway_secret")
  webhookSecret String?  @map("webhook_secret")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_payment_configs")
}

model InvoiceRecord {
